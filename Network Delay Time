#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define INF 1000000

typedef struct {
    int to;
    int weight;
} Edge;

int networkDelayTime(int** times, int timesSize, int* timesColSize, int n, int k) {
    int* head = (int*)malloc((n + 1) * sizeof(int));
    int* next = (int*)malloc(timesSize * sizeof(int));
    Edge* edges = (Edge*)malloc(timesSize * sizeof(Edge));
    
    for (int i = 1; i <= n; i++) {
        head[i] = -1;
    }
    
    for (int i = 0; i < timesSize; i++) {
        int u = times[i][0];
        edges[i].to = times[i][1];
        edges[i].weight = times[i][2];
        next[i] = head[u];
        head[u] = i;
    }
    
    int* dist = (int*)malloc((n + 1) * sizeof(int));
    int* visited = (int*)calloc((n + 1), sizeof(int));
    
    for (int i = 1; i <= n; i++) {
        dist[i] = INF;
    }
    dist[k] = 0;
    
    for (int i = 0; i < n; i++) {
        int u = -1;
        int minDist = INF;
        
        for (int j = 1; j <= n; j++) {
            if (!visited[j] && dist[j] < minDist) {
                minDist = dist[j];
                u = j;
            }
        }
        
        if (u == -1) break;
        visited[u] = 1;
        
        for (int e = head[u]; e != -1; e = next[e]) {
            int v = edges[e].to;
            int weight = edges[e].weight;
            if (dist[u] + weight < dist[v]) {
                dist[v] = dist[u] + weight;
            }
        }
    }
    
    int maxDelay = 0;
    for (int i = 1; i <= n; i++) {
        if (dist[i] == INF) {
            free(head);
            free(next);
            free(edges);
            free(dist);
            free(visited);
            return -1;
        }
        if (dist[i] > maxDelay) {
            maxDelay = dist[i];
        }
    }
    
    free(head);
    free(next);
    free(edges);
    free(dist);
    free(visited);
    
    return maxDelay;
}
